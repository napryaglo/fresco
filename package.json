{
  "name": "@pragmatic-lab/fresco",
  "version": "0.2.0",
  "description": "Graph visualization library built on top of mural",
  "type": "module",
  "main": "dist/ge/index.js",
  "types": "dist/ge/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ge/index.d.ts",
      "default": "./dist/ge/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "http://localhost:4873/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "ge": "tsx src/ge/main.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@pragmatic-lab/mural": "^0.1.1",
    "yaml": "^2.9.0"
  }
}
